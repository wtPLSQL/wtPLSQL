$IF $$WTPLSQL_SELFTEST  ------%WTPLSQL_begin_ignore_lines%------
$THEN
   procedure WTPLSQL_RUN
   is
   begin
      --------------------------------------  WTPLSQL Testing --
      wtplsql.g_DBOUT := 'WT_TEST_RUN:PACKAGE BODY';
      t_set_g_test_runs_rec;
      t_clear_last_run;
      t_insert_test_run;
      t_delete_runs;
      t_initialize;
      t_finalize1;
      t_finalize2;
      t_get_last_run_flag;
      t_set_last_run;
      t_delete_run_id;
   end;
$END  ----------------%WTPLSQL_end_ignore_lines%----------------
--==============================================================--


end wt_test_run;
