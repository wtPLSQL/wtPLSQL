------------------------------------------------------------
function delete_run_id
      (in_test_run_id  in number)
   return number
is
   l_test_runner_id  number;
   ret_num           number;
begin
   begin
      select test_runner_id
       into  l_test_runner_id
       from  wt_test_runs
       where id = in_test_run_id;
   exception when NO_DATA_FOUND then
      return 0;
   end;
   delete from wt_test_runs where id = in_test_run_id;
   ret_num := SQL%ROWCOUNT;
   set_last_run(l_test_runner_id);
   return ret_num;
end delete_run_id;

