-- Not Testing Finalization
-- All components already tested
procedure finalize1
is
   junk  number;
begin  ------%WTPLSQL_begin_ignore_lines%------
   set_g_test_runs_rec;
   junk := delete_runs(g_test_runs_rec.test_runner_id);
   insert_test_run;                          -- With COMMIT
   wt_result.finalize(g_test_runs_rec.id);   -- With COMMIT
   wt_profile.finalize(g_test_runs_rec.id);  -- With COMMIT
end finalize1;  ----------------%WTPLSQL_end_ignore_lines%----------------

