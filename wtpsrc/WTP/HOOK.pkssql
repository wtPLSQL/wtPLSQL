
--
--  Create WTP.HOOK Package
--

set define off


--DBMS_METADATA:WTP.HOOK

  CREATE OR REPLACE EDITIONABLE PACKAGE "WTP"."HOOK" 
   authid definer
as

   procedure run
         (in_hook_name  in varchar2);

   procedure init;

   --   WtPLSQL Self Test Procedures
   --
   -- alter system set PLSQL_CCFLAGS =
   --    'WTPLSQL_SELFTEST:TRUE'
   --    scope=BOTH;
   --
   $IF $$WTPLSQL_SELFTEST
   $THEN
      g_run_assert_hook  boolean := TRUE;
      g_test_hook_msg    varchar2(4000);
      --
      procedure test_hook
         (in_msg  in  varchar2);
      procedure WTPLSQL_RUN;
   $END

end hook;
/


--  Grants
grant EXECUTE on "WTP"."HOOK" to "PUBLIC";


--  Synonyms


set define on
