
--
--  Create WTP.JUNIT_CORE_REPORT Package
--

set define off


--DBMS_METADATA:WTP.JUNIT_CORE_REPORT

  CREATE OR REPLACE EDITIONABLE PACKAGE "WTP"."JUNIT_CORE_REPORT" 
   authid definer
as

   g_in_process  boolean := FALSE;

   TYPE vc_aa_type is table of varchar2(4000) index by pls_integer;
   vc_aa   vc_aa_type;

   procedure xml_header;

   procedure xml_body;

   procedure xml_trailer;

   procedure before_test_all;

   procedure show_current;

   procedure after_test_all;

   procedure insert_hooks;

   procedure delete_hooks;

end junit_core_report;
/


--  Grants
grant EXECUTE on "WTP"."JUNIT_CORE_REPORT" to "PUBLIC";


