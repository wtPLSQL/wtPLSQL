  GRANT CREATE SEQUENCE TO "WTP";
  GRANT CREATE DATABASE LINK TO "WTP";
  GRANT CREATE PROCEDURE TO "WTP";
  GRANT CREATE TRIGGER TO "WTP";
  GRANT CREATE TYPE TO "WTP";
  GRANT CREATE JOB TO "WTP";

