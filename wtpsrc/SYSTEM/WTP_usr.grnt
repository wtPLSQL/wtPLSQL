

--
--  Create WTP Grants
--

set define off



--  Database System Privileges

grant CREATE DATABASE LINK to "WTP";
grant CREATE JOB to "WTP";
grant CREATE PROCEDURE to "WTP";
grant CREATE PUBLIC SYNONYM to "WTP";
grant CREATE SEQUENCE to "WTP";
grant CREATE SESSION to "WTP";
grant CREATE TABLE to "WTP";
grant CREATE TRIGGER to "WTP";
grant CREATE TYPE to "WTP";
grant CREATE VIEW to "WTP";
grant EXECUTE ANY PROCEDURE to "WTP";


set define on

