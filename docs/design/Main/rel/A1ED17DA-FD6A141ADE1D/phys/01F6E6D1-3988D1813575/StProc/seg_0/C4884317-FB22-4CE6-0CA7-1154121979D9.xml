<source>CREATE OR REPLACE PROCEDURE       WTP.WT_EXECUTE_TEST_RUNNER
   authid current_user
   -- AUTHID CURRENT_USER is required for assertions with
   --   dynamic PL/SQL execution.
is
   sql_txt  varchar2(4000);
begin
   sql_txt := &apos;begin &quot;&apos; || core_data.g_run_rec.test_runner_name  ||
                   &apos;&quot;.&apos; || wtplsql.C_RUNNER_ENTRY_POINT          || &apos;; end;&apos;;
   --dbms_output.put_line(sql_txt);
   execute immediate sql_txt;
end wt_execute_test_runner;</source>
